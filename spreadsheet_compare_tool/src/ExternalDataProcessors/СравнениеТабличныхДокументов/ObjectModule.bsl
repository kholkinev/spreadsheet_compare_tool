// проверка корректности заполнения необходимых настроек
Функция ПроверитьКорректностьЗаполнения()
	
	СписокОшибок 	= Новый Массив;
	Отказ 			= Ложь;
	
	// тип файлов
	Если НЕ ЗначениеЗаполнено(ТипФайлов) Тогда
		СписокОшибок.Добавить("Не указан тип файлов");
	КонецЕсли;	
	
	// файлы
	Если НЕ ЗначениеЗаполнено(Файл1) Тогда
		СписокОшибок.Добавить("Не указан первый файл");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл2) Тогда
		СписокОшибок.Добавить("Не указан второй файл");
	КонецЕсли;	
	
	// начальные и конечные строки и колонки
	// первый файл
	Если НЕ ЗначениеЗаполнено(Файл1НачальнаяСтрока) Тогда
		СписокОшибок.Добавить("Не указана начальная строка первого файла");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл1КонечнаяСтрока) Тогда
		СписокОшибок.Добавить("Не указана конечная строка первого файла");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл1НачальнаяКолонка) Тогда
		СписокОшибок.Добавить("Не указана начальная колонка первого файла");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл1КонечнаяКолонка) Тогда
		СписокОшибок.Добавить("Не указана конечная колонка первого файла");
	КонецЕсли;	
	// второй файл
	Если НЕ ЗначениеЗаполнено(Файл2НачальнаяСтрока) Тогда
		СписокОшибок.Добавить("Не указана начальная строка второго файла");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл2КонечнаяСтрока) Тогда
		СписокОшибок.Добавить("Не указана конечная строка второго файла");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл2НачальнаяКолонка) Тогда
		СписокОшибок.Добавить("Не указана начальная колонка второго файла");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Файл2КонечнаяКолонка) Тогда
		СписокОшибок.Добавить("Не указана конечная колонка второго файла");
	КонецЕсли;	
	
	// правильность указания строк и колонок
	Если Файл1КонечнаяСтрока < Файл1НачальнаяСтрока Тогда
		СписокОшибок.Добавить("Неверно указано расположение строк первого файла");
	КонецЕсли;	
	Если Файл2КонечнаяСтрока < Файл2НачальнаяСтрока Тогда
		СписокОшибок.Добавить("Неверно указано расположение строк второго файла");
	КонецЕсли;	
	Если Файл1КонечнаяКолонка < Файл1НачальнаяКолонка Тогда
		СписокОшибок.Добавить("Неверно указано расположение колонок первого файла");
	КонецЕсли;	
	Если Файл2КонечнаяКолонка < Файл2НачальнаяКолонка Тогда
		СписокОшибок.Добавить("Неверно указано расположение колонок второго файла");
	КонецЕсли;	
	
	// сопоставление строк
	Если СопоставлениеСтрок.Количество() = 0 Тогда
		СписокОшибок.Добавить("Не указано соспоставление строк по колонкам");
	Иначе	
		Для Каждого Строка Из СопоставлениеСтрок Цикл
			
			// заполненность колонок
			Если НЕ ЗначениеЗаполнено(Строка.Файл1) ИЛИ НЕ ЗначениеЗаполнено(Строка.Файл2) Тогда
				СписокОшибок.Добавить("Сопоставление строк, строка "+Строка.НомерСтроки+": некорректно указана настройка");
			//Иначе
			//	
			//	Если Строка.Файл1 < Файл1НачальнаяКолонка ИЛИ Строка.Файл1 > Файл1КонечнаяКолонка Тогда
			//		СписокОшибок.Добавить("Сопоставление строк, строка "+Строка.НомерСтроки+": колонка первого файла должна быть в диапазоне ["+Файл1НачальнаяКолонка+".."+Файл1КонечнаяКолонка+"]");
			//	КонецЕсли;	
			//	Если Строка.Файл2 < Файл2НачальнаяКолонка ИЛИ Строка.Файл2 > Файл2КонечнаяКолонка Тогда
			//		СписокОшибок.Добавить("Сопоставление строк, строка "+Строка.НомерСтроки+": колонка аторого файла должна быть в диапазоне ["+Файл2НачальнаяКолонка+".."+Файл2КонечнаяКолонка+"]");
			//	КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;	
	
	// сравнение строк
	Если СравнениеСтрок.Количество() = 0 Тогда
		СписокОшибок.Добавить("Не указано сравнение строк по колонкам");
	Иначе	
		Для Каждого Строка Из СравнениеСтрок Цикл
			Если НЕ ЗначениеЗаполнено(Строка.Файл1) ИЛИ НЕ ЗначениеЗаполнено(Строка.Файл2) Тогда
				СписокОшибок.Добавить("Сравнение строк, строка "+Строка.НомерСтроки+": некорректно указана настройка");
			Иначе
				// проверим диапазон
				//Если Строка.Файл1 < Файл1НачальнаяКолонка ИЛИ Строка.Файл1 > Файл1КонечнаяКолонка Тогда
				//	СписокОшибок.Добавить("Сравнение строк, строка "+Строка.НомерСтроки+": колонка первого файла должна быть в диапазоне ["+Файл1НачальнаяКолонка+".."+Файл1КонечнаяКолонка+"]");
				//КонецЕсли;	
				//Если Строка.Файл2 < Файл2НачальнаяКолонка ИЛИ Строка.Файл2 > Файл2КонечнаяКолонка Тогда
				//	СписокОшибок.Добавить("Сравнение строк, строка "+Строка.НомерСтроки+": колонка второго файла должна быть в диапазоне ["+Файл2НачальнаяКолонка+".."+Файл2КонечнаяКолонка+"]");
				//КонецЕсли;
				// поле сравнения обязательно должно быть в выводимых полях
				//ЕстьПоле = Ложь;
				//Для Каждого ВыводимаяКолонка Из ВыводимыеКолонкиФайл1 Цикл
				//	Если ВыводимаяКолонка.Наименование = Строка.Файл1 Тогда
				//		ЕстьПоле = Истина;
				//		Прервать;
				//	КонецЕсли;	
				//КонецЦикла;
				//Если НЕ ЕстьПоле Тогда
				//	СписокОшибок.Добавить("Сравнение строк, строка "+Строка.НомерСтроки+": колонка первого файла должна быть включена в список выводимых колонок");
				//КонецЕсли;	
				//
				//ЕстьПоле = Ложь;
				//Для Каждого ВыводимаяКолонка Из ВыводимыеКолонкиФайл2 Цикл
				//	Если ВыводимаяКолонка.НомерКолонки = Строка.Файл2 Тогда
				//		ЕстьПоле = Истина;
				//		Прервать;
				//	КонецЕсли;	
				//КонецЦикла;
				//Если НЕ ЕстьПоле Тогда
				//	СписокОшибок.Добавить("Сравнение строк, строка "+Строка.НомерСтроки+": колонка второго файла должна быть включена в список выводимых колонок");
				//КонецЕсли;	
				
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	
	Если СписокОшибок.Количество() > 0 Тогда
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Для Каждого Ошибка Из СписокОшибок Цикл
			Сообщение.Текст = Ошибка;
			Сообщение.Сообщить(); 
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции	

