// автозаполнение начальных и конечных строк и колонок
Процедура АвтоЗаполнениеНачальныхКонечныхСтрокКолонок(Режим) Экспорт
	
	РеквизитКолонкаНачало 	= ?(Режим = "1", "Файл1НачальнаяКолонка", "Файл2НачальнаяКолонка");
	РеквизитКолонкаКонец 	= ?(Режим = "1", "Файл1КонечнаяКолонка", "Файл2КонечнаяКолонка");
	
	РеквизитСтрокаНачало	= ?(Режим = "1", "Файл1НачальнаяСтрока", "Файл2НачальнаяСтрока");
	РеквизитСтрокаКонец		= ?(Режим = "1", "Файл1КонечнаяСтрока", "Файл2КонечнаяСтрока");
	
	//мФайл					= ?(Режим = "1", Файл1, Файл2);
	//
	//Если НЕ ЗначениеЗаполнено(мФайл) Тогда
	//	Возврат;
	//КонецЕсли;
	
	ЭтотОбъект[РеквизитСтрокаНачало] = 1;
	ЭтотОбъект[РеквизитКолонкаНачало] = 1;
	
	СтруктураКонечныхЗначений = Неопределено;
	
	СтруктураКонечныхЗначений = ПолучитьСтруктуруКонечныхЗначенийMXL(Режим);
	
	Если СтруктураКонечныхЗначений <> Неопределено Тогда
		ЭтотОбъект[РеквизитСтрокаКонец] 	= СтруктураКонечныхЗначений.СтрокаКонец;
		ЭтотОбъект[РеквизитКолонкаКонец] 	= СтруктураКонечныхЗначений.КолонкаКонец;
