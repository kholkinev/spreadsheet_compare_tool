Процедура ВыполнитьСравнение() Экспорт
	
	//++ Консист Холькин Е.В. 13.08.2021 
	СоответствиеИменКолонок1 = Новый Соответствие;
	СоответствиеИменКолонок2 = Новый Соответствие;
	//-- Консист Холькин Е.В. 13.08.2021 
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// обнулим соответствия
	ИменаКолонок1 = Новый Соответствие;
	ИменаКолонок2 = Новый Соответствие;
	
	ТипыКолонок1 = Новый Соответствие;
	ТипыКолонок2 = Новый Соответствие;
	
	// проверка правильности заполнения необходимых данных
	Отказ = ПроверитьКорректностьЗаполнения();
	Если Отказ Тогда
		Возврат ;
	КонецЕсли;
	
	// получим таблицы файлов необходимой структуры
	Таблица1 = ПолучитьСтруктуруТаблицы("1");
	Таблица2 = ПолучитьСтруктуруТаблицы("2");
	
	ЗаполнитьТаблицуMXL("1",Таблица1);
	ЗаполнитьТаблицуMXL("2",Таблица2);
	
	
	Если Таблица1.Количество() = 0 Тогда
		Возврат ;
	КонецЕсли;
	
	// преобразуем числовые строки в числа
	ПреобразоватьЧисловыеСтроки("1",Таблица1);
	ПреобразоватьЧисловыеСтроки("2",Таблица2);
	
	// признак вывода разницы
	ВыводитьРазницу = ПроверитьВозможностьВыводаРазницы();
	
	// добавим в таблицы регистронезависимые колонки
	Если НеУчитыватьРегистр Тогда
		ДобавитьРегистронезависимыеКолонки("2",Таблица2);
	КонецЕсли;	
	
	// собственно, сравнение
	Если ПоследовательноеСравнение Тогда
		ТабДокумент = СравнитьТаблицыПоследовательно(Таблица1,Таблица2);
	Иначе
		ТабДокумент = СравнитьТаблицы(Таблица1,Таблица2);
	КонецЕсли;	
	
	  Результат = ТабДокумент;
	
КонецПроцедуры

// формирование таблиц, необходимой структуры
Функция ПолучитьСтруктуруТаблицы(Режим)
	
	Таблица = Новый ТаблицаЗначений;
	
	ИмяРеквизитаНачало 	= "Файл"+Режим+"НачальнаяКолонка";
	ИмяРеквизитаКонец 	= "Файл"+Режим+"КонечнаяКолонка";
	
	Начало 	= ЭтотОбъект[ИмяРеквизитаНачало];
	Конец	= ЭтотОбъект[ИмяРеквизитаКонец];
	
	Для i = Начало По Конец Цикл
		
		ИмяКолонки = "К"+i;
		Таблица.Колонки.Добавить(ИмяКолонки);
		
	КонецЦикла;	
	
	Возврат Таблица;
	
