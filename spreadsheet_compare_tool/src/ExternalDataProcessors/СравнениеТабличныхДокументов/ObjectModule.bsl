// определение конечных параметров для файлов MXL
Функция ПолучитьСтруктуруКонечныхЗначенийMXL(Режим) Экспорт
	
	ТабДок				= ?(Режим = "1", Файл1ТабДок, Файл2ТабДок);
	СтруктураЗначений 	= Новый Структура("СтрокаКонец,КолонкаКонец");
	
		
	СтруктураЗначений.СтрокаКонец 	= ТабДок.ПолучитьРазмерОбластиДанныхПоВертикали();
	СтруктураЗначений.КолонкаКонец 	= ТабДок.ПолучитьРазмерОбластиДанныхПоГоризонтали();
	
		
	Возврат СтруктураЗначений;
	
КонецФункции	

// установка отборов по результатам сравнения
Процедура ОтображениеРезультатаУстановитьОтбор(РежимОтбора) Экспорт
	ТабДокумент = Результат;
	НужныйПризнак = 0;
	Если 		РежимОтбора = "ОтборВсе" 		Тогда НужныйПризнак = 0;
	ИначеЕсли 	РежимОтбора = "ОтборОтличия" 	Тогда НужныйПризнак = ПризнакНеРавно;	
	ИначеЕсли 	РежимОтбора = "Отбор1" 			Тогда НужныйПризнак = ПризнакТолько1;
	ИначеЕсли 	РежимОтбора = "Отбор2" 			Тогда НужныйПризнак = ПризнакТолько2;
	КонецЕсли;	
	
	i = 4;
	Пока Истина Цикл
		
		ТекущаяСтрока = ПолучитьСтроку(i);
		Ячейка = ТабДокумент.Область("R"+ТекущаяСтрока);
		
		Признак = ПолучитьЧисло(Ячейка.Текст);
		Если Признак = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если НужныйПризнак = 0 Тогда
			Ячейка.Видимость = Истина;
		ИначеЕсли Признак = НужныйПризнак Тогда	
			Ячейка.Видимость = Истина;
		Иначе
			Ячейка.Видимость = Ложь;
		КонецЕсли;	
			
		i = i + 1;	
			
	КонецЦикла;	
	Результат = ТабДокумент;		
КонецПроцедуры	

// инициализация исходных ширин колонок
Процедура УстановитьИсходнуюШиринуКолонок(ТабДокумент) Экспорт
	
	ИсходнаяШиринаКолонок = Новый Соответствие;
	КоличествоКолонок = ТабДокумент.ШиринаТаблицы;
	
	Для i = 1 По КоличествоКолонок Цикл
		
		ТекущаяКолонка = ПолучитьСтроку(i);
		Область = ТабДокумент.Область("C"+ТекущаяКолонка);
		ИсходнаяШиринаКолонок.Вставить(i,Область.ШиринаКолонки);
		
	КонецЦикла;	
	
КонецПроцедуры	

Функция РазложитьСтрокуВМассивПодстрокЛокальная(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено) Экспорт
	
	МассивПодстрок = Новый Массив;
	
	// для обеспечения обратной совместимости
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда 
			Если Разделитель = " " Тогда
				МассивПодстрок.Добавить("");
			КонецЕсли;
			Возврат МассивПодстрок;
		КонецЕсли;
	КонецЕсли;
	//
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			МассивПодстрок.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		МассивПодстрок.Добавить(Строка);
	КонецЕсли;
	
	Возврат МассивПодстрок;
	
КонецФункции   

