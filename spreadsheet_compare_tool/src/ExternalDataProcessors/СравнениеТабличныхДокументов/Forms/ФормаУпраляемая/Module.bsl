&НаСервере
Процедура СопоставлениеСтрокЗаполнитьНаСервере()
	Объект.СопоставлениеСтрок.Очистить();
	Для Каждого Строка Из Объект.ВыводимыеКолонкиФайл1 Цикл
		
		ИндексСтроки = Строка.НомерСтроки - 1;
		Если Строка.ТипЗначения = "Текст" Тогда
			
			НоваяСтрока = Объект.СопоставлениеСтрок.Добавить();
			НоваяСтрока.Файл1 = Строка.Наименование;
			
			Попытка
				ВтораяСтрока = Объект.ВыводимыеКолонкиФайл2[ИндексСтроки];
				НоваяСтрока.Файл2 = ВтораяСтрока.Наименование;
			Исключение
			КонецПопытки;
			
		КонецЕсли;	
		
	КонецЦикла;	

КонецПроцедуры

