&НаСервере
Процедура СравнитьНаСервере()
	// засекаем время
	ВремяНачала = ТекущаяДата();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		
	// очишаем поле результата
	Объект.Результат.Очистить();
	
	// получим результат сравнения
	 ОбработкаОбъект.ВыполнитьСравнение();
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект,"Объект");	
	// переключимся на вкладку "Результат"
	Элементы.Настройки.ТекущаяСтраница = Элементы.РезультатСравнения;
	
	// установим ползунок в значение 100%
	//ЭлементыФормы.ПолосаРегулирования.Значение = 100;
	
	//УстановитьИсходнуюШиринуКолонок(ЭлементыФормы.ПолеРезультат);
	
	// выведем время
	ВремяОкончания = ТекущаяДата();
	РазницаВремени = ВремяОкончания - ВремяНачала;
	РазницаВремени = '00010101' + РазницаВремени;
	РазницаВремени = Формат(РазницаВремени,"ДЛФ=T");
	//ТекстСостояния = "Найдено различий: "+ВсегоРазличий+". Время выполнения: "+РазницаВремени;
	
	// индикация
	//ЭлементыФормы.Индикатор.Значение = 0;

КонецПроцедуры

