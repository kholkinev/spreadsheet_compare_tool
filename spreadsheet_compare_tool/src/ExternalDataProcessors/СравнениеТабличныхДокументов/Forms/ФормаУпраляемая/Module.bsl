//
&НаКлиенте
Функция ЗаполнитьКраткоеИмяФайла(ПолноеИмяФайла, Режим)
	Если Режим = 1 Тогда
		Реквизит = "ИмяФайла1";
	Иначе
		Реквизит = "ИмяФайла2" ;
	КонецЕсли;
	ПозицияПоследнегоСлэша = СтрНайти(ПолноеИмяФайла,"\",НаправлениеПоиска.СКонца,,1);
	ДлинаСтроки = СтрДлина(ПолноеИмяФайла);
	ЧислоСимволов = ДлинаСтроки-ПозицияПоследнегоСлэша;
	КраткоеИмя = Прав(ПолноеИмяФайла,ЧислоСимволов);
	Объект[Реквизит] = КраткоеИмя;

	

КонецФункции // ЗАполнитьКраткоеИмяФайла()

