&НаКлиенте
Процедура ТипФайловПриИзменении(Элемент)
	
	Объект.ЭтоMXL = (Объект.ТипФайлов = "*.mxl");
	Объект.ЭтоXLS = (Объект.ТипФайлов = "*.xls");
	Объект.ЭтоXLSX = (Объект.ТипФайлов = "*.xlsx");
	СтрокаПоиска = СтрЗаменить(Объект.ТипФайлов,"*","");
	
	Если СтрНайти(Объект.Файл1, СтрокаПоиска, НаправлениеПоиска.СКонца, СтрДлина(Объект.Файл1))  = 0 Тогда
		Объект.Файл1 = "";
	КонецЕсли;
	
	Если СтрНайти(Объект.Файл2, СтрокаПоиска, НаправлениеПоиска.СКонца, СтрДлина(Объект.Файл2))  = 0 Тогда
		Объект.Файл2 = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Файл2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.Файл2 = ПолучитьРезультатВыбораФайла();
	Адрес = "";
	
	Если ЗначениеЗаполнено(Объект.Файл2) Тогда
		НачатьПомещениеФайла(Новый ОписаниеОповещения("Файл2НачалоВыбораЗавершение", ЭтаФорма, Новый Структура("Адрес", Адрес)), Адрес, Объект.Файл2, Ложь);
		ЗаполнитьКраткоеИмяФайла(Объект.Файл2,2);
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите файл";
		Сообщение.Сообщить();
	КонецЕсли;
	
	Объект.ИмяЛистаФайла2 = "";

КонецПроцедуры

&НаКлиенте
Функция ПолучитьРезультатВыбораФайла()
	
	Результат = "";
	
	Если Объект.ЭтоMXL Тогда
		Фильтр 	= "Табличный файл 1С (*.mxl)|*.mxl";
	ИначеЕсли Объект.ЭтоXLSX Тогда
		Фильтр 	= "Документ MS Excel (*.xlsx)|*.xlsx";
	ИначеЕсли Объект.ЭтоXLS Тогда
		Фильтр 	= "Документ MS Excel (*.xls)|*.xls";
	Иначе
		Возврат Результат;
	КонецЕсли;	
	
	Режим 	= РежимДиалогаВыбораФайла.Открытие;
	
	Диалог = Новый ДиалогВыбораФайла(Режим);
	Диалог.Фильтр 				= Фильтр;
	Диалог.МножественныйВыбор 	= Ложь;
	
	Если Диалог.Выбрать() Тогда
		Результат = Диалог.ПолноеИмяФайла;		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

