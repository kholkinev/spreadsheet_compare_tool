&НаСервере
Процедура ЗагрузитьТабДокИзФайла(Адрес, Режим, Знач ИмяЛиста = "")
	
	РеквизитСИменемЛиста = ?(Режим = "1", "ИмяЛистаФайла1", "ИмяЛистаФайла2");
	
	ИмяВременогоФайла = ПолучитьИмяВременногоФайла(СтрЗаменить(Объект.ТипФайлов, "*", ""));    
    Файл = ПолучитьИзВременногоХранилища(Адрес);
    Файл.Записать(ИмяВременогоФайла);
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Прочитать(ИмяВременогофайла);
	
	ТребуемыйТабДок = ?(Режим = "1", "Файл1ТабДок", "Файл2ТабДок");
	Объект[ТребуемыйТабДок] = ТабДок;
	
	Если НЕ Объект.ЭтоMXL Тогда
		
		Если ИмяЛиста = "" ИЛИ Элементы[РеквизитСИменемЛиста].СписокВыбора.Количество() = 0 Тогда
			
			ИмяТЧ = ?(Режим = "1", "ЛистыФайла1", "ЛистыФайла2");
			Объект[ИмяТЧ].Очистить();
			
			Элементы[РеквизитСИменемЛиста].СписокВыбора.Очистить();
			
			Для Каждого Область Из ТабДок.Области Цикл
				НовСтрока = Объект[ИмяТЧ].Добавить();
				НовСтрока.ИмяЛиста = Область.Имя;
				Элементы[РеквизитСИменемЛиста].СписокВыбора.Добавить(Область.Имя, Область.Имя);
			КонецЦикла;
			
			Объект[РеквизитСИменемЛиста] = Элементы[РеквизитСИменемЛиста].СписокВыбора[0];
			Объект[ТребуемыйТабДок] = Объект[ТребуемыйТабДок].ПолучитьОбласть(Элементы[РеквизитСИменемЛиста].СписокВыбора[0]);
			
		Иначе
			
			Объект[ТребуемыйТабДок] = Объект[ТребуемыйТабДок].ПолучитьОбласть(ИмяЛиста);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

