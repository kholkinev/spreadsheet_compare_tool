Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	// Попытка нужна для первого входа, пока произвольных сохраняемых значений в сохраненных настройках нет.
	
	Попытка
		Объект.СопоставлениеСтрок.Загрузить(Настройки.Получить("СопоставлениеСтрок"));
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.СравнениеСтрок.Загрузить(Настройки.Получить("СравнениеСтрок"));
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ВыводимыеКолонкиФайл1.Загрузить(Настройки.Получить("ВыводимыеКолонкиФайл1"));
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ВыводимыеКолонкиФайл2.Загрузить(Настройки.Получить("ВыводимыеКолонкиФайл2"));
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ЛистыФайла1.Загрузить(Настройки.Получить("ЛистыФайла1"));
		Элементы.ИмяЛистаФайла1.СписокВыбора.ЗагрузитьЗначения(Объект.ЛистыФайла1.Выгрузить().ВыгрузитьКолонку("ИмяЛиста"));
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ЛистыФайла2.Загрузить(Настройки.Получить("ЛистыФайла2"));
		Элементы.ИмяЛистаФайла2.СписокВыбора.ЗагрузитьЗначения(Объект.ЛистыФайла2.Выгрузить().ВыгрузитьКолонку("ИмяЛиста"));
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ТипФайлов = Настройки.Получить("Объект.ТипФайлов");
	Исключение
	КонецПопытки;
	
	Попытка
		Объект.ЭтоMXL = (Объект.ТипФайлов = "*.mxl");
		Объект.ЭтоXLS = (Объект.ТипФайлов = "*.xls");
		Объект.ЭтоXLSX = (Объект.ТипФайлов = "*.xlsx");
	Исключение
	КонецПопытки;
	
КонецПроцедуры

