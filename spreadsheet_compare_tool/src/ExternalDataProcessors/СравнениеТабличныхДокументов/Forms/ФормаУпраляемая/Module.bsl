&НаКлиенте
Процедура ПрочитатьФайл1()
	
	Адрес = "";
	
	Если ЗначениеЗаполнено(Объект.Файл1) Тогда 
		
		ЗаполнитьКраткоеИмяФайла(Объект.Файл1, 1);
		
		Попытка
			НачатьПомещениеФайла(Новый ОписаниеОповещения("Файл1НачалоВыбораЗавершение", ЭтаФорма, Новый Структура("Адрес", Адрес)), Адрес,Объект.Файл1, Ложь);			 			 
		Исключение
			Объект.Файл1 = "";
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл2()
	
	Адрес = "";
	
	Если ЗначениеЗаполнено(Объект.Файл2) Тогда 
		
		ЗаполнитьКраткоеИмяФайла(Объект.Файл2, 2);
		
		Попытка
			
			НачатьПомещениеФайла(Новый ОписаниеОповещения("Файл2НачалоВыбораЗавершение", ЭтаФорма, Новый Структура("Адрес", Адрес)), Адрес,Объект.Файл2, Ложь);
			
		Исключение
			Объект.Файл2 = "";					
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьФайл1(Команда)
	ПрочитатьФайл1();
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьФайл2(Команда)
	ПрочитатьФайл2();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяОбработки = Сред(Этаформа.ИмяФормы, СтрНайти(Этаформа.ИмяФормы, ".")+1, СтрНайти(Этаформа.ИмяФормы, ".Форма") - СтрНайти(Этаформа.ИмяФормы, ".")-1);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяЛистаФайла1ПриИзменении(Элемент)
	
	ПрочитатьФайл1();
	
КонецПроцедуры

